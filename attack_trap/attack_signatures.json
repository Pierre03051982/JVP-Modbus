{
  "_comment": "Angriffsmuster fuer Log-Watcher und Honeypot-Klassifizierung. instant_* -> sofortige Sperre. strike_* -> erst nach strike_threshold Treffern (siehe config.json), damit legitime Zugriffe nicht sofort sperren.",

  "instant_ban_paths": [
    "\\.env($|[?/])",
    "/\\.git/",
    "/\\.svn/",
    "/\\.aws/",
    "/\\.ssh/",
    "/wp-login\\.php",
    "/wp-admin",
    "/xmlrpc\\.php",
    "/phpmyadmin",
    "/pma/",
    "/adminer",
    "/vendor/phpunit",
    "/eval-stdin\\.php",
    "/actuator/",
    "/solr/",
    "/boaform/",
    "/HNAP1",
    "/cgi-bin/",
    "/etc/passwd",
    "/proc/self/environ",
    "\\.\\./\\.\\.",
    "%2e%2e%2f",
    "(?:union[^a-z]+select|select.+from.+information_schema)",
    "(?:<script>|onerror=|javascript:)",
    "base64_decode\\(",
    "system\\(",
    "/shell\\??",
    "/\\.well-known/.*\\.php",
    "/config\\.(php|json|ya?ml)\\b",
    "/wp-content/plugins/.*\\.php\\?",
    "/telescope/requests",
    "/\\.docker",
    "/dbadmin"
  ],

  "instant_ban_user_agents": [
    "sqlmap",
    "nikto",
    "nmap",
    "masscan",
    "zgrab",
    "zmap",
    "nuclei",
    "gobuster",
    "dirbuster",
    "feroxbuster",
    "wfuzz",
    "ffuf",
    "hydra",
    "wpscan",
    "xmrig",
    "l9explore",
    "censys",
    "custom-asynchttpclient"
  ],

  "strike_paths": [
    "/administrator",
    "/admin\\.php",
    "/setup(\\.php)?",
    "/install(\\.php)?",
    "/manager/html",
    "/api/.*(token|key|secret)",
    "\\.(bak|old|sql|zip|tar\\.gz|7z|rar)($|\\?)",
    "/backup",
    "/\\.htaccess",
    "/server-status",
    "/owa/auth"
  ]
}
